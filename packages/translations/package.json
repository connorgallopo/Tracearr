{
  "name": "@tracearr/translations",
  "version": "0.1.0",
  "description": "Shared i18n resources and helpers for Tracearr apps",
  "license": "AGPL-3.0-only",
  "author": "Connor Gallopo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connorgallopo/Tracearr.git",
    "directory": "packages/translations"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "react-native": "./src/mobile.ts",
      "import": "./dist/mobile.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/locales/_template",
    "!dist/locales/_template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-locales.js",
    "prepublishOnly": "pnpm build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "check": "tsx scripts/check-translations.ts",
    "check:english": "tsx scripts/find-english-regressions.ts"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "react-i18next": "^17.0.9"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "sideEffects": false
}
