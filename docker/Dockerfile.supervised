# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Tracearr All-in-One Image (Supervised)
# Runs TimescaleDB, Redis, and Tracearr in a single container
# Ideal for simple deployments, Unraid, Synology, etc.

FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS builder

# pnpm's install script is what puts its native binary in place. corepack never runs it,
# and npm 12 blocks it unless allowed, so both leave pnpm's shebang-less fallback shim instead.
RUN npm install -g --allow-scripts=pnpm pnpm@12.3.4

WORKDIR /app

# Copy ALL workspace package.json files for lockfile resolution
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/emails/package.json ./packages/emails/
COPY packages/translations/package.json ./packages/translations/
COPY packages/test-utils/package.json ./packages/test-utils/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code. data/ only goes into the final image, so it stays out of this layer and its cache.
COPY --exclude=data . .

# Build only production packages
RUN pnpm turbo run build --filter=@tracearr/shared --filter=@tracearr/server --filter=@tracearr/web

# =============================================================================
# Production All-in-One Image
# =============================================================================
# Same image and digest as the builder, so the runtime Node is the pinned one and every
# layer below rebuilds when that pin moves instead of staying in the build cache.
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

# Install dependencies
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    lsb-release \
    supervisor \
    gosu \
    openssl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g --allow-scripts=pnpm pnpm@12.3.4

# Install PostgreSQL 15 + TimescaleDB
# TimescaleDB 2.28.x is the last line PG15 supports (2.29+ requires PG16+), and
# .github/renovate.json holds this pin to it. Bumping past 2.28.x means a PG major
# upgrade (dump/restore) first. Dockerfile.timescale carries the same pin.
# renovate: datasource=deb depName=timescaledb-2-postgresql-15
ARG TIMESCALEDB_VERSION=2.28.3~debian12-1518
RUN curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql-keyring.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && curl -fsSL https://packagecloud.io/timescale/timescaledb/gpgkey | gpg --dearmor -o /usr/share/keyrings/timescaledb-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/timescaledb-keyring.gpg] https://packagecloud.io/timescale/timescaledb/debian/ bookworm main" > /etc/apt/sources.list.d/timescaledb.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-15 \
        "timescaledb-2-postgresql-15=${TIMESCALEDB_VERSION}" \
        timescaledb-tools \
        timescaledb-toolkit-postgresql-15 \
        attr \
    && rm -rf /var/lib/apt/lists/*

# Install Tailscale VPN binary (userspace networking, no root required)
# renovate: datasource=deb depName=tailscale
ARG TAILSCALE_VERSION=1.104.2
RUN curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg -o /usr/share/keyrings/tailscale-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/tailscale-keyring.gpg] https://pkgs.tailscale.com/stable/debian bookworm main" > /etc/apt/sources.list.d/tailscale.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "tailscale=${TAILSCALE_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

# Install Redis 8 from official Redis repository
# redis-server depends on the exact same redis-tools version, so both take the pin.
# renovate: datasource=deb depName=redis-server
ARG REDIS_VERSION=6:8.10.2-1rl1~bookworm1
RUN curl -fsSL https://packages.redis.io/gpg | gpg --dearmor -o /usr/share/keyrings/redis-keyring.gpg \
    && chmod 644 /usr/share/keyrings/redis-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/redis-keyring.gpg] https://packages.redis.io/deb bookworm main" > /etc/apt/sources.list.d/redis.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "redis-server=${REDIS_VERSION}" "redis-tools=${REDIS_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

# Note: PostgreSQL config is applied during initdb in entrypoint-supervised.sh
# The /etc/postgresql/15/main/ config is not used since we use a custom data directory

# Configure Redis to listen only on localhost
RUN sed -i 's/^bind .*/bind 127.0.0.1/' /etc/redis/redis.conf \
    && sed -i 's/^daemonize yes/daemonize no/' /etc/redis/redis.conf

# Create tracearr user for running the application (non-root)
RUN groupadd --system --gid 1001 tracearr \
    && useradd --system --uid 1001 --gid tracearr --shell /bin/false tracearr

# Create app directory
WORKDIR /app

# Basemap tiles change far less often than anything below, so they come first and stay cached
COPY --chown=tracearr:tracearr data/basemap.pmtiles ./data/basemap.pmtiles
COPY --chown=tracearr:tracearr data/BASEMAP_NOTICE.txt ./data/BASEMAP_NOTICE.txt

# Server runtime deps only: the web app ships as static files, so its packages never load here (ignore-scripts keeps prepare/husky out).
# Installed before any build output is copied so a code-only change reuses this layer.
COPY --chown=tracearr:tracearr package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY --chown=tracearr:tracearr apps/server/package.json ./apps/server/
COPY --chown=tracearr:tracearr packages/shared/package.json ./packages/shared/
COPY --chown=tracearr:tracearr packages/emails/package.json ./packages/emails/
RUN pnpm install --prod --frozen-lockfile --ignore-scripts --filter @tracearr/server... \
    && chown -R tracearr:tracearr /app

# GeoIP databases, refreshed from MaxMind on every build
COPY --chown=tracearr:tracearr data/GeoLite2-City.mmdb ./data/GeoLite2-City.mmdb
COPY --chown=tracearr:tracearr data/GeoLite2-ASN.mmdb ./data/GeoLite2-ASN.mmdb

# Copy built application from builder
COPY --from=builder --chown=tracearr:tracearr /app/apps/server/dist ./apps/server/dist
COPY --from=builder --chown=tracearr:tracearr /app/apps/server/scripts ./apps/server/scripts
COPY --from=builder --chown=tracearr:tracearr /app/apps/web/dist ./apps/web/dist
COPY --from=builder --chown=tracearr:tracearr /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=tracearr:tracearr /app/packages/emails/dist ./packages/emails/dist
COPY --from=builder --chown=tracearr:tracearr /app/apps/server/src/db/migrations ./apps/server/src/db/migrations
COPY --from=builder --chown=tracearr:tracearr /app/assets/logo.png ./assets/logo.png

# Create data directories with proper ownership
RUN mkdir -p /data/postgres /data/redis /data/tracearr /data/backup /var/log/supervisor \
    && chown -R postgres:postgres /data/postgres \
    && chown -R redis:redis /data/redis \
    && chown -R tracearr:tracearr /data/tracearr /data/backup

# Supervisord configuration
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Startup scripts
COPY docker/entrypoint-supervised.sh /entrypoint.sh
COPY docker/start-tracearr.sh /start-tracearr.sh
RUN chmod 755 /entrypoint.sh /start-tracearr.sh

# Build arguments for version info (must redeclare in each stage)
ARG APP_VERSION=0.0.0
ARG APP_TAG=
ARG APP_COMMIT=
ARG APP_BUILD_DATE=

ARG CACHE_BUST
# Write build info to JSON file - can't be overridden by compose ENV vars

RUN echo "Build: ${APP_VERSION} (${APP_COMMIT}) - ${CACHE_BUST:-nocache}" && \
    printf '{"version":"%s","tag":"%s","commit":"%s","buildDate":"%s"}\n' \
      "${APP_VERSION}" "${APP_TAG}" "${APP_COMMIT}" "${APP_BUILD_DATE}" > /app/.build-info.json

# Environment defaults
ENV NODE_ENV=production \
    LOG_LEVEL=info \
    PORT=3000 \
    HOST=0.0.0.0 \
    TZ=UTC \
    DATABASE_URL=postgresql://tracearr:tracearr@127.0.0.1:5432/tracearr \
    REDIS_URL=redis://127.0.0.1:6379 \
    APP_VERSION=${APP_VERSION} \
    APP_TAG=${APP_TAG} \
    APP_COMMIT=${APP_COMMIT} \
    APP_BUILD_DATE=${APP_BUILD_DATE}

# Expose only the web port
EXPOSE 3000

# Volumes for persistent data
VOLUME ["/data/postgres", "/data/redis", "/data/tracearr", "/data/backup"]

# Inside the already-mounted /data/tracearr volume, so existing installs keep
# their poster cache across a recreate without editing their compose file.
ENV IMAGE_CACHE_DIR=/data/tracearr/image-cache

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://127.0.0.1:3000/health || exit 1

# OCI image labels for container registries and tools like Renovate
LABEL org.opencontainers.image.source="https://github.com/connorgallopo/Tracearr" \
      org.opencontainers.image.url="https://github.com/connorgallopo/Tracearr" \
      org.opencontainers.image.title="Tracearr Supervised" \
      org.opencontainers.image.description="Streaming access manager for Plex, Jellyfin, and Emby (all-in-one)" \
      org.opencontainers.image.vendor="connorgallopo" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${APP_COMMIT}" \
      org.opencontainers.image.created="${APP_BUILD_DATE}"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
