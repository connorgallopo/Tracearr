{
  "name": "@tracearr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc && tsc -p tsconfig.scripts.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint src/ --cache --cache-location .eslintcache --cache-strategy content",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:services": "vitest run --config vitest.services.config.ts",
    "test:routes": "vitest run --config vitest.routes.config.ts",
    "test:auth": "vitest run --config vitest.auth.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:services:coverage": "vitest run --config vitest.services.config.ts --coverage",
    "test:routes:coverage": "vitest run --config vitest.routes.config.ts --coverage",
    "test:auth:coverage": "vitest run --config vitest.auth.config.ts --coverage",
    "clean": "rm -rf dist .turbo coverage",
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.cjs",
    "db:push": "drizzle-kit push --config=drizzle.config.cjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.cjs",
    "reset-password": "node dist/scripts/reset-password.js",
    "cli": "node dist/scripts/cli.js",
    "backup": "tsx scripts/backup.ts",
    "openapi:dump": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.0.0",
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^10.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@tracearr/shared": "workspace:*",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-auth": "1.6.27",
    "bullmq": "^5.76.5",
    "cacheable-lookup": "^7.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eventsource": "^4.1.0",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "maxmind": "^5.0.6",
    "pg": "^8.22.0",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.3",
    "stream-json": "^3.0.0",
    "undici": "^8.9.0",
    "unzipper": "^0.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tracearr/test-utils": "workspace:*",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/country-list": "^2.1.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/stream-json": "^1.7.8",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
