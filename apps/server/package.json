{
  "name": "@tracearr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc && tsc -p tsconfig.scripts.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:services": "vitest run --config vitest.services.config.ts",
    "test:routes": "vitest run --config vitest.routes.config.ts",
    "test:auth": "vitest run --config vitest.auth.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:services:coverage": "vitest run --config vitest.services.config.ts --coverage",
    "test:routes:coverage": "vitest run --config vitest.routes.config.ts --coverage",
    "test:auth:coverage": "vitest run --config vitest.auth.config.ts --coverage",
    "clean": "rm -rf dist .turbo coverage",
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.cjs",
    "db:push": "drizzle-kit push --config=drizzle.config.cjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.cjs",
    "reset-password": "node dist/scripts/reset-password.js",
    "cli": "node dist/scripts/cli.js",
    "backup": "tsx scripts/backup.ts",
    "openapi:dump": "tsx scripts/generate-openapi.ts",
    "templates:fingerprint": "tsx scripts/template-fingerprints.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@better-auth/core": "1.7.21",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.8",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@tracearr/emails": "workspace:*",
    "@tracearr/shared": "workspace:*",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-auth": "1.7.21",
    "bullmq": "^6.7.7",
    "cacheable-lookup": "^7.0.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "eventsource": "^5.1.5",
    "expo-server-sdk": "^8.0.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "maxmind": "^5.1.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stream-json": "^3.9.0",
    "undici": "^8.12.4",
    "unzipper": "^0.12.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tracearr/test-utils": "workspace:*",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/country-list": "^2.1.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/stream-json": "^1.7.8",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
