{
  "name": "@tracearr/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern '*.config.*' --ignore-pattern '.expo/' --cache --cache-location .eslintcache --cache-strategy content",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform all",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "update": "eas update"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.8",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "^2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "@tracearr/shared": "workspace:*",
    "@tracearr/translations": "workspace:*",
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~57.0.10",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-maps": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.7",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.28.0",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "2.32.0",
    "react-native-nitro-modules": "^0.36.4",
    "react-native-quick-crypto": "^1.1.4",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.11.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "victory-native": "41.26.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.2.18",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-preset-expo": "~57.0.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
